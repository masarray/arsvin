<Window x:Class="AR.Iec61850.SvPublisher.PreflightResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AR.Iec61850.SvPublisher.Models"
        Title="Preflight results"
        Width="620"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F5F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="TextStrong" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#DDE5F0" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#D7E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SeverityPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="#E0F2FE" />
            <Setter Property="BorderBrush" Value="#BAE6FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:LivePreflightSeverity.Error}">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:LivePreflightSeverity.Warning}">
                    <Setter Property="Background" Value="#FEF3C7" />
                    <Setter Property="BorderBrush" Value="#FCD34D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#E1EAF5" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Preflight Results" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="Quick looptest diagnostics. Warnings do not block live publish; fatal errors do." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding LivePreflightSummaryText}" FontWeight="SemiBold" Foreground="#1E3A8A" />
                    <TextBlock FontSize="12" Foreground="#475569" Margin="0,4,0,0">
                        <Run Text="Fatal " />
                        <Run Text="{Binding LivePreflightErrorCount, Mode=OneWay}" />
                        <Run Text=" · Warnings " />
                        <Run Text="{Binding LivePreflightWarningCount, Mode=OneWay}" />
                        <Run Text=" · Info " />
                        <Run Text="{Binding LivePreflightInfoCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="KM Looptest" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="10">
            <ListBox ItemsSource="{Binding LivePreflightDiagnostics}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SeverityPill}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap">
                                        <Run Text="{Binding Area, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy report" Click="CopyReport_Click" />
            <Button Content="Close" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
