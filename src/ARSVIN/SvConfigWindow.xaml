<Window x:Class="AR.Iec61850.SvPublisher.SvConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AR.Iec61850.SvPublisher.Controls"
        Title="SV Setup"
        Width="1060"
        Height="760"
        MinWidth="960"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F5F7FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Line" Color="#DDE5F0" />
        <SolidColorBrush x:Key="TextStrong" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E3A8A" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#D7E2F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Background" Value="#2563EB" />
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#DDE5F0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#FFFFFF" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="12" Padding="10" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Card" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="14" Background="#FFFFFF" BorderBrush="#E1EAF5" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SV Setup" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                    <TextBlock Text="Select streams, choose source mode, and publish from the main Start button." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open SCL" Command="{Binding OpenSclCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="COMTRADE" Command="{Binding ImportComtradeCommand}" />
                    <Button Content="Check" Click="Check_Click" />
                    <Button Content="Save" Command="{Binding SaveProfileCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="SV streams" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text="Click a card to edit." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" CornerRadius="10" Padding="8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding LiveSafetyStatusText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    </Border>

                    <ListBox ItemsSource="{Binding PublisherSlots}" SelectedItem="{Binding SelectedPublisherSlot}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StreamCardTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="8,2,0,0" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                        <Border Background="#E0F2FE" CornerRadius="8" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding SourceBadgeText}" Style="{StaticResource PillText}" /></Border>
                                        <Border Background="#F1F5F9" CornerRadius="8" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" /></Border>
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedStreamHeaderText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            <TextBlock Text="{Binding SclSummary}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Warnings" Click="Check_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="SCL stream" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" DisplayMemberPath="Label" Margin="0,4,0,8" />
                            <TextBlock Text="NIC adapter" Style="{StaticResource LabelText}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAdaptersCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Source mode" Style="{StaticResource LabelText}" />
                            <WrapPanel Margin="0,4,0,2">
                                <Button Content="Manual" Style="{StaticResource ChipButton}" Click="SourceManual_Click" />
                                <Button Content="Ramp" Style="{StaticResource ChipButton}" Click="SourceRamp_Click" />
                                <Button Content="Sequence" Style="{StaticResource ChipButton}" Click="SourceSequence_Click" />
                                <Button Content="COMTRADE" Style="{StaticResource ChipButton}" Click="SourceComtrade_Click" />
                            </WrapPanel>
                            <CheckBox Content="Enable selected stream" IsChecked="{Binding SelectedPublisherSlot.IsEnabled}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Network" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="svID" Style="{StaticResource LabelText}" />
                                <TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding StreamId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Text="DataSet" Style="{StaticResource LabelText}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DataSetReference, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Text="APPID" Style="{StaticResource LabelText}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Dst MAC" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DestinationMac, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Text="Src MAC" Style="{StaticResource LabelText}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SourceMac, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Row="3" Grid.Column="2" Content="VLAN" IsChecked="{Binding UseVlan}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="66" Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="prio" Style="{StaticResource LabelText}" Margin="10,0,5,0" />
                                    <TextBox Width="46" Text="{Binding VlanPriority, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="Rate" Style="{StaticResource LabelText}" />
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SampleRatePresets}" SelectedItem="{Binding SelectedSampleRatePreset}" DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="smpSynch" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                <ComboBox Grid.Row="4" Grid.Column="3" ItemsSource="{Binding SyncPolicyChoices}" SelectedItem="{Binding SelectedSyncPolicyChoice}" DisplayMemberPath="Label" />
                            </Grid>

                            <Expander Header="Advanced" IsExpanded="False" Margin="0,0,0,12">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="1.15*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="dLSB I" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1" Text="{Binding CurrentDlsb, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="dLSB V" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                    <TextBox Grid.Column="3" Text="{Binding VoltageDlsb, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Text="PTP domain" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExpectedPtpDomain, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="PTP traffic" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding PtpPublisherModes}" SelectedItem="{Binding PtpPublisherMode}" />

                                    <TextBlock Grid.Row="2" Text="Clock ID" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PtpClockIdentityText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Entries" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center">
                                        <Run Text="{Binding DataSetEntryCount, Mode=OneWay}" /><Run Text=" / mapped " /><Run Text="{Binding MappedSignalCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Expander>

                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SyncPolicyHelpText}" TextWrapping="Wrap" Foreground="#7C2D12" FontSize="12" />
                            </Border>

                            <Grid>
                                <Border Visibility="{Binding IsConfigManualWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Manual Output" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Continuous point-to-point looptest values. Edit detailed phasors in the main manual workspace." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                            <controls:WaveformPlot Channels="{Binding Channels}" Height="140" Margin="0,12,0,0" />
                                        </StackPanel>
                                        <controls:PhasorPlot Grid.Column="1" Channels="{Binding Channels}" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <Border Visibility="{Binding IsConfigRampWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Ramp Timeline" Style="{StaticResource SectionTitle}" />
                                        <controls:RampTimelinePlot RampStates="{Binding RampStates}" Height="150" />
                                        <TextBlock Text="Ramp uses the configured state timing and stops after the final state." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Visibility="{Binding IsConfigSequencerWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="State Sequence" Style="{StaticResource SectionTitle}" />
                                        <controls:StateTimelinePlot SequenceStates="{Binding SequenceStates}" Height="150" />
                                        <TextBlock Text="Sequencer follows each state duration. Loop remains optional for replay-style tests." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Visibility="{Binding IsConfigComtradeWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="COMTRADE Replay" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding SelectedPublisherSlot.ComtradeSummary}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Loop" IsChecked="{Binding SelectedPublisherSlot.ComtradeLoop}" VerticalAlignment="Center" />
                                        </Grid>
                                        <controls:WaveformPlot Channels="{Binding Channels}" Height="160" />
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <Border Background="#FFFFFF" CornerRadius="9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,6,0"><TextBlock Text="IA ← COMTRADE A1" FontSize="11" TextWrapping="Wrap" /></Border>
                                            <Border Background="#FFFFFF" CornerRadius="9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,6,0"><TextBlock Text="IB ← COMTRADE A2" FontSize="11" TextWrapping="Wrap" /></Border>
                                            <Border Background="#FFFFFF" CornerRadius="9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,6,0"><TextBlock Text="IC ← COMTRADE A3" FontSize="11" TextWrapping="Wrap" /></Border>
                                            <Border Background="#FFFFFF" CornerRadius="9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8"><TextBlock Text="Vabc auto mapped" FontSize="11" TextWrapping="Wrap" /></Border>
                                        </UniformGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Import COMTRADE" Command="{Binding ImportComtradeCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Clear" Command="{Binding ClearComtradeCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LiveSafetyStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" />
            <Button Grid.Column="1" Content="Close" IsCancel="True" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
