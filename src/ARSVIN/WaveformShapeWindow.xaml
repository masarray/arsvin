<Window x:Class="AR.Iec61850.SvPublisher.WaveformShapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waveform shaping"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Advanced waveform shaping" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
            <TextBlock Text="Publisher-side lab shaping for manual output and the selected sequencer state. Keep clean defaults for normal SV publishing."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,3,0,14" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <TabControl>
                <TabItem Header="Manual output shape">
                    <DockPanel Margin="0,12,0,0">
                        <Border DockPanel.Dock="Top"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                                These values are applied only to Manual publishing. They stay out of the main window so normal magnitude, angle, and frequency editing remains clean.
                            </TextBlock>
                        </Border>

                        <DataGrid ItemsSource="{Binding Channels}" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="56" IsReadOnly="True" />
                                <DataGridTextColumn Header="DC offset %" Binding="{Binding DcOffsetPercent, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="Harmonic %" Binding="{Binding HarmonicPercent, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="H order" Binding="{Binding HarmonicOrder, UpdateSourceTrigger=PropertyChanged}" Width="84" />
                                <DataGridTextColumn Header="Clip %" Binding="{Binding ClipPercent, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding WaveformShapeSummary}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Selected sequencer state">
                    <Grid Margin="0,12,0,0" DataContext="{Binding SelectedSequenceState}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                                Edit only the selected State Sequencer row here. Scenario presets may auto-fill these fields; this panel lets engineering users tune them without crowding the main window.
                            </TextBlock>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="State" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Scenario tag" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="18,0,0,0" />
                            <TextBox Grid.Column="3" Text="{Binding ScenarioTag, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Per-phase multipliers and angle offsets" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="1" Text="A" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="B" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="C" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="N" HorizontalAlignment="Center" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Text="I mult" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentScaleA, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CurrentScaleB, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CurrentScaleC, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CurrentScaleN, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />

                                    <TextBlock Grid.Row="2" Text="V mult" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VoltageScaleA, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding VoltageScaleB, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding VoltageScaleC, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding VoltageScaleN, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />

                                    <TextBlock Grid.Row="3" Text="Angle °" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AngleOffsetA, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding AngleOffsetB, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding AngleOffsetC, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding AngleOffsetN, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />

                                    <TextBlock Grid.Row="4" Text="Base" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentScale, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding VoltageScale, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding FrequencyHz, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="3" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="Distortion / transient shaping" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="I DC offset %" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Column="1" Text="{Binding CurrentDcOffsetPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="V DC offset %" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VoltageDcOffsetPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="2" Text="I harmonic %" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentHarmonicPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="3" Text="V harmonic %" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VoltageHarmonicPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="4" Text="Harmonic order" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HarmonicOrder, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="5" Text="I / V clip %" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <Grid Grid.Row="5" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CurrentClipPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                        <TextBox Grid.Column="2" Text="{Binding VoltageClipPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                                               Text="Note: CT saturation, DC offset, harmonic, and clipping are publisher-side lab approximations, not calibrated transient simulation models."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset manual shape" Click="ResetManualShape_Click" />
            <Button Content="Reset state shape" Click="ResetStateShape_Click" />
            <Button Content="Close" IsCancel="True" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
