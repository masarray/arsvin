<Window x:Class="ARSVIN.Subscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ArSubsv - Sampled Values Subscriber"
        Width="1460"
        Height="860"
        MinWidth="1220"
        MinHeight="720"
        Background="{StaticResource ShellBg}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinWidth="96"
                        Height="34"
                        Padding="10,0"
                        Background="#FFFFFF"
                        BorderBrush="#DCE6F3"
                        BorderThickness="1"
                        CornerRadius="11"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ArSubsv" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" Background="#EAF2FF" VerticalAlignment="Center">
                            <TextBlock Text="SV" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                </Border>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter}"
                          DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center" />

                <Button Grid.Column="4" Style="{StaticResource ToolbarButton}" Content="Refresh" Command="{Binding RefreshAdaptersCommand}" />

                <TextBox Grid.Column="6"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by APPID, svID, MAC, VLAN"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenSclCommand}" Content="Import SCL" Margin="0,0,6,0" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCaptureFileCommand}" Content="Open PCAP" Margin="0,0,6,0" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}" Content="Clear" Margin="0,0,6,0" />
                    <Border CornerRadius="9" Background="#F8FBFF" BorderBrush="#DCE6F3" BorderThickness="1" Padding="9,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding HealthText}" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCaptureCommand}" Content="{Binding CaptureButtonText}" Width="92" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelShell}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#F8FBFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="12,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock Text="SV Explorer" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SclText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Streams}"
                             SelectedItem="{Binding SelectedStream}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="11"
                                        Background="#FFFFFF"
                                        BorderBrush="#D8E2EF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Padding="8,3" CornerRadius="9" Background="#EAF2FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SvId}" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding Health}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Fps, StringFormat={}{0} fps}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="1,7,0,0">
                                            <TextBlock Text="{Binding AppId}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="smpCnt " Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="{Binding SmpCnt}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="12,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedStream.SvId}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedStream.Bound}" Foreground="{StaticResource Blue}" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PTP/Sync " Foreground="{StaticResource Dim}" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedStream.SmpSynch}" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,12,0" />
                            <TextBlock Text="gap " Foreground="{StaticResource Dim}" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedStream.Gap}" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,6">
                            <TextBlock Text="Waveform" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="2-cycle live monitor" Foreground="{StaticResource Muted}" FontSize="11" />
                        </DockPanel>
                        <Border x:Name="ScopeHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.95*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,6">
                            <TextBlock Text="Phasor" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="RMS / angle" Foreground="{StaticResource Muted}" FontSize="11" />
                        </DockPanel>
                        <Border x:Name="PhasorHost" Grid.Row="1" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />

                <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#F8FBFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="12,0">
                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                <TextBlock Text="RMS Values" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="Voltage / Current" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedStream.Phasors}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="46" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="72" />
                                <DataGridTextColumn Header="RMS" Binding="{Binding RmsText}" Width="80" />
                                <DataGridTextColumn Header="Peak" Binding="{Binding PeakText}" Width="80" />
                                <DataGridTextColumn Header="Angle" Binding="{Binding AngleText}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="9,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Raw " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding TotalFramesText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="SV " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding SvFramesText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="Streams " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding StreamsText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="FPS " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding GlobalFpsText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="Duration " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding CaptureDurationText}" Style="{StaticResource MonoText}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
