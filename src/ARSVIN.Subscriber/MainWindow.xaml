<Window x:Class="ARSVIN.Subscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ArSubsv - Sampled Values Subscriber"
        Width="1460"
        Height="860"
        MinWidth="1220"
        MinHeight="720"
        Background="{StaticResource ShellBg}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.RowSpan="2"
                        Grid.Column="0"
                        Padding="12,0"
                        Background="#F8FBFF"
                        BorderBrush="#DCE6F3"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ArSubsv" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6" Background="#EAF2FF" VerticalAlignment="Center">
                                <TextBlock Text="SV" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Subscriber scout" Style="{StaticResource CaptionText}" Margin="1,2,0,0" />
                    </StackPanel>
                </Border>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter}"
                          DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#F8FBFF" BorderBrush="#DCE6F3" BorderThickness="1" Padding="10,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Health " Foreground="{StaticResource Dim}" FontSize="11" />
                            <TextBlock Text="{Binding HealthText}" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CaptureToggleButton}" Command="{Binding ToggleCaptureCommand}" Content="{Binding CaptureButtonText}" />
                </StackPanel>

                <DockPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Raw " Foreground="{StaticResource Dim}" FontSize="11" />
                                <TextBlock Text="{Binding TotalFramesText}" Style="{StaticResource MonoText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SV " Foreground="{StaticResource Dim}" FontSize="11" />
                                <TextBlock Text="{Binding SvFramesText}" Style="{StaticResource MonoText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Streams " Foreground="{StaticResource Dim}" FontSize="11" />
                                <TextBlock Text="{Binding StreamsText}" Style="{StaticResource MonoText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FPS " Foreground="{StaticResource Dim}" FontSize="11" />
                                <TextBlock Text="{Binding GlobalFpsText}" Style="{StaticResource MonoText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenSclCommand}" Content="Import SCL" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCaptureFileCommand}" Content="Open PCAP" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportReportCommand}" Content="Export" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ToolbarButton}" Click="CompareEvidence_Click" Content="Compare" ToolTip="Compare two ARSVIN evidence JSON reports" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshAdaptersCommand}" Content="Refresh" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}" Content="Clear" Margin="0,0,6,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelShell}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelHeader}">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <TextBlock Text="SV Explorer" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SclText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Streams}"
                             SelectedItem="{Binding SelectedStream}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="#FFFFFF"
                                        BorderBrush="#D8E2EF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Padding="8,3" CornerRadius="6" Background="#EAF2FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SvId}" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding Health}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Fps, StringFormat={}{0} fps}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="1,7,0,0">
                                            <TextBlock Text="{Binding AppId}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="smpCnt " Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="{Binding SmpCnt}" Foreground="#64748B" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="12,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedStream.SvId}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedStream.Bound}" Foreground="{StaticResource Blue}" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PTP/Sync " Foreground="{StaticResource Dim}" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedStream.SmpSynch}" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,12,0" />
                            <TextBlock Text="gap " Foreground="{StaticResource Dim}" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedStream.Gap}" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelShell}" Padding="10,7" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2,0,14,0">
                            <TextBlock Text="PROFILE" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.Profile}" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2,0,14,0">
                            <TextBlock Text="CONFIDENCE" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.Confidence}" Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="2,0,14,0">
                            <TextBlock Text="SCL MATCH" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.SclMatch}" Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="2,0,0,0">
                            <TextBlock Text="WINDOW" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.Window}" Foreground="{StaticResource Muted}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Grid.Row="2" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Evidence details" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text=" · " Foreground="{StaticResource Dim}" />
                            <TextBlock Text="{Binding SelectedStream.ComparisonMode}" Foreground="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Margin="0,6,0,0" Padding="10,7" CornerRadius="8" Background="#FBFDFF" BorderBrush="#DCE6F3" BorderThickness="1" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedStream.EvidenceDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <Border Grid.Row="3" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,6">
                            <TextBlock Text="Waveform" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedStream.WaveformState}" Foreground="{StaticResource Muted}" FontSize="11" />
                        </DockPanel>
                        <Border x:Name="ScopeHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.95*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,6">
                            <TextBlock Text="Phasor" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="RMS / angle" Foreground="{StaticResource Muted}" FontSize="11" />
                        </DockPanel>
                        <Border x:Name="PhasorHost" Grid.Row="1" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />

                <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelHeader}">
                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                <TextBlock Text="RMS Values" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="Voltage / Current" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TabControl Grid.Row="1" Margin="8,6,8,8">
                            <TabItem Header="RMS">
                                <DataGrid ItemsSource="{Binding SelectedStream.Phasors}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="46" />
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="64" />
                                        <DataGridTextColumn Header="RMS" Binding="{Binding RmsText}" Width="*" />
                                        <DataGridTextColumn Header="Peak" Binding="{Binding PeakText}" Width="*" />
                                        <DataGridTextColumn Header="Angle" Binding="{Binding AngleText}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Decoded">
                                <DataGrid ItemsSource="{Binding SelectedValues}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42" />
                                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="72" />
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="58" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="10,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Duration " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding CaptureDurationText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="Issues " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding IssuesText}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                    <TextBlock Text="SCL " Foreground="{StaticResource Dim}" FontSize="11" />
                    <TextBlock Text="{Binding SclText}" Style="{StaticResource MonoText}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
    </Grid>
</Window>