<Window x:Class="ARSVIN.Subscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ArSubsv - Sampled Values Subscriber"
        Width="1500"
        Height="900"
        MinWidth="1280"
        MinHeight="760"
        Background="{StaticResource ShellBg}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="HealthTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="GOOD">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="QUIET">
                    <Setter Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="WARN">
                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="BAD">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="ERROR">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="UNKNOWN">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldStateStyle" TargetType="TextBlock" BasedOn="{StaticResource HealthTextStyle}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldAxisCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="RightAlignedGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <Style x:Key="StreamListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,0"
                        Background="#F8FBFF"
                        BorderBrush="#DCE6F3"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ArSubsv" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6" Background="#EAF2FF" VerticalAlignment="Center">
                                <TextBlock Text="SV" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Field-ready Sampled Values subscriber"
                                   Style="{StaticResource CaptionText}"
                                   Margin="1,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" />

                        <Border Grid.Column="2"
                                Height="38"
                                MinWidth="112"
                                CornerRadius="8"
                                Background="#F8FBFF"
                                BorderBrush="#DCE6F3"
                                BorderThickness="1"
                                Padding="12,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Health" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource HealthTextStyle}" FontSize="11.5" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="4"
                                Style="{StaticResource CaptureToggleButton}"
                                Command="{Binding ToggleCaptureCommand}"
                                Content="{Binding CaptureButtonText}"
                                VerticalContentAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="10">
                        <Button Style="{StaticResource HeaderActionButton}" Command="{Binding OpenSclCommand}" Content="Import SCL" />
                        <Button Style="{StaticResource HeaderActionButton}" Command="{Binding OpenCaptureFileCommand}" Content="Open PCAP" />
                        <Button Style="{StaticResource HeaderActionButton}" Command="{Binding ExportReportCommand}" Content="Export" />
                        <Button Style="{StaticResource HeaderActionButton}" Click="CompareEvidence_Click" Content="Compare" ToolTip="Compare two ARSVIN evidence JSON reports" />
                        <Button Style="{StaticResource HeaderActionButton}" Command="{Binding RefreshAdaptersCommand}" Content="Refresh" />
                        <Button Style="{StaticResource HeaderActionButton}" Command="{Binding ClearCommand}" Content="Clear" />
                        <Button Style="{StaticResource HeaderActionButton}" Click="MeasurementContext_Click" Content="CT / VT" ToolTip="Edit CT and VT measurement context for the selected stream" />
                        <Button Style="{StaticResource HeaderActionButton}" Click="ImportMeasurementContext_Click" Content="Import Ctx" />
                        <Button Style="{StaticResource HeaderActionButton}" Click="ExportMeasurementContext_Click" Content="Export Ctx" />
                        <Button Style="{StaticResource HeaderActionButton}" Click="KnownInjection_Click" Content="Validate" ToolTip="Compare the selected engineering phasor with a known injection" />
                    </UniformGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricPill}" Padding="9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Raw" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalFramesText}" Style="{StaticResource MonoText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}" Padding="9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SV" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SvFramesText}" Style="{StaticResource MonoText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}" Padding="9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Streams" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StreamsText}" Style="{StaticResource MonoText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}" Padding="9,4" Margin="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Capture" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GlobalFpsText}" Style="{StaticResource MonoText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="270" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="590" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelShell}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SV Explorer" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SclText}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10.5"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="10,0,0,0" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Streams}"
                             SelectedItem="{Binding SelectedStream}"
                             ItemContainerStyle="{StaticResource StreamListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="11,9"
                                        MinHeight="64"
                                        CornerRadius="8"
                                        Background="#FFFFFF"
                                        BorderBrush="#D8E2EF"
                                        BorderThickness="1"
                                        ToolTip="{Binding HealthDetail}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="22" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding SvId}"
                                                   Foreground="#1D4ED8"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Health}"
                                                   Style="{StaticResource HealthTextStyle}"
                                                   FontSize="10.5"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding Fps, StringFormat={}{0} fps}"
                                                   Foreground="#64748B"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding AppId}"
                                                   Foreground="#64748B"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="smpCnt"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Text="{Binding SmpCnt}"
                                                   Foreground="#64748B"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="116" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedStream.SvId}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedStream.Bound}"
                                       Foreground="{StaticResource Blue}"
                                       FontSize="10.8"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedStream.ContinuityText}" Foreground="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="{Binding SelectedStream.CadenceText}" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Text="{Binding SelectedStream.CaptureWindowText}" Foreground="{StaticResource Dim}" FontSize="10.2" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelShell}" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="3,0,14,7" VerticalAlignment="Center">
                            <TextBlock Text="MAPPING" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.GenericMappingState}" Foreground="{StaticResource Blue}" FontSize="11.2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="3,0,14,7" VerticalAlignment="Center">
                            <TextBlock Text="SEMANTICS" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.GenericSemanticState}" Foreground="{StaticResource Muted}" FontSize="11.2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="3,0,0,7" VerticalAlignment="Center">
                            <TextBlock Text="CONFIGURATION" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.SclMatch}" Foreground="{StaticResource Muted}" FontSize="11.2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="3,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="SCALING" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.Scaling}" Foreground="{StaticResource Blue}" FontSize="11.2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="TIMEBASE" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.Timebase}" Foreground="{StaticResource Muted}" FontSize="11.2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="3,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ANALYSIS WINDOW" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedStream.AnalysisWindowText}" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="10.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Grid.Row="2" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Evidence details" Foreground="{StaticResource Blue}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedStream.ComparisonMode}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Margin="0,6,0,0" Padding="10,7" CornerRadius="8" Background="#FBFDFF" BorderBrush="#DCE6F3" BorderThickness="1" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedStream.EvidenceDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <Border Grid.Row="3" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Waveform" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedStream.GenericWaveformState}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10.8"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,0,0,7"
                                Padding="4"
                                CornerRadius="7"
                                Background="{StaticResource PanelDeep}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1">
                            <UniformGrid Columns="5">
                                <Border Style="{StaticResource FieldAxisCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="CAPTURE" Foreground="{StaticResource Dim}" FontSize="9.2" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStream.CaptureFieldState}" Style="{StaticResource FieldStateStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FieldAxisCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="PROTOCOL" Foreground="{StaticResource Dim}" FontSize="9.2" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStream.ProtocolFieldState}" Style="{StaticResource FieldStateStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FieldAxisCard}" ToolTip="{Binding SelectedStream.AnalysisTrustDetail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="STREAM" Foreground="{StaticResource Dim}" FontSize="9.2" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStream.StreamFieldState}" Style="{StaticResource FieldStateStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FieldAxisCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="CONFIG" Foreground="{StaticResource Dim}" FontSize="9.2" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStream.ConfigurationFieldState}" Style="{StaticResource FieldStateStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FieldAxisCard}" ToolTip="{Binding SelectedStream.MeasurementFieldDetail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="MEASUREMENT" Foreground="{StaticResource Dim}" FontSize="9.2" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStream.MeasurementFieldState}" Style="{StaticResource FieldStateStyle}" />
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <Border x:Name="ScopeHost" Grid.Row="2" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.02*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.98*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Phasor" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedStream.PhasorState}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border x:Name="PhasorHost" Grid.Row="1" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />

                <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="RMS Values" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Evidence-aware units" Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <TabControl Grid.Row="1" Margin="8,6,8,8">
                            <TabItem Header="RMS">
                                <DataGrid ItemsSource="{Binding SelectedStream.GenericPhasors}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="42" />
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="62" />
                                        <DataGridTextColumn Header="RMS" Binding="{Binding RmsText}" Width="*" ElementStyle="{StaticResource RightAlignedGridText}" />
                                        <DataGridTextColumn Header="Peak" Binding="{Binding PeakText}" Width="*" ElementStyle="{StaticResource RightAlignedGridText}" />
                                        <DataGridTextColumn Header="Angle" Binding="{Binding AngleText}" Width="70" ElementStyle="{StaticResource RightAlignedGridText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Decoded">
                                <DataGrid ItemsSource="{Binding SelectedStream.GenericValues}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" />
                                        <DataGridTextColumn Header="Word / SCL signal" Binding="{Binding Signal}" Width="130" />
                                        <DataGridTextColumn Header="Representation" Binding="{Binding Kind}" Width="92" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="*" />
                                        <DataGridTextColumn Header="Semantics" Binding="{Binding ScalingText}" Width="115" />
                                        <DataGridTextColumn Header="Raw bytes" Binding="{Binding Raw}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelShell}" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Duration" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CaptureDurationText}" Style="{StaticResource MonoText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="Issues" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IssuesText}" Style="{StaticResource MonoText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="SCL" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SclText}" Style="{StaticResource MonoText}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource Blue}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>