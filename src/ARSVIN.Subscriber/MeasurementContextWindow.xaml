<Window x:Class="ARSVIN.Subscriber.MeasurementContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SV Measurement Context"
        Width="620"
        Height="650"
        MinWidth="560"
        MinHeight="600"
        Background="{StaticResource ShellBg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelShell}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Primary / secondary measurement context" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="StreamText" Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource Dim}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Ratios are explicit engineering evidence. Device or vendor identity is never used to invent a ratio." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PanelShell}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Wire engineering domain" FontWeight="SemiBold" />
                            <ComboBox x:Name="WireDomainBox" Margin="0,6,0,0" />
                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="How the scaled SV value is interpreted before CT/VT conversion." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Preferred display domain" FontWeight="SemiBold" />
                            <ComboBox x:Name="DisplayDomainBox" Margin="0,6,0,0" />
                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="Waveform, decoded values, RMS and phasors use this domain when a valid ratio exists." />
                        </StackPanel>
                    </Grid>
                </Border>

                <GroupBox Header="Current transformer / sensor context" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Primary nominal (A)" />
                            <TextBox x:Name="CurrentPrimaryText" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Secondary nominal (A)" />
                            <TextBox x:Name="CurrentSecondaryText" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Evidence source" />
                            <ComboBox x:Name="CurrentSourceBox" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="Reference" />
                            <TextBox x:Name="CurrentReferenceText" Margin="0,5,0,0" ToolTip="For example: SMU615 current input configuration, SCL extension, or test record." />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,9,0,0" FontSize="10.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Leave both nominal fields empty when current conversion is not established." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Voltage transformer / sensor context" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Primary nominal (V)" />
                            <TextBox x:Name="VoltagePrimaryText" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Secondary nominal (V)" />
                            <TextBox x:Name="VoltageSecondaryText" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Evidence source" />
                            <ComboBox x:Name="VoltageSourceBox" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="Reference" />
                            <TextBox x:Name="VoltageReferenceText" Margin="0,5,0,0" ToolTip="For example: SMU615 voltage input configuration, SCL extension, or test record." />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,9,0,0" FontSize="10.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Leave both nominal fields empty when voltage conversion is not established." />
                    </Grid>
                </GroupBox>

                <Border Style="{StaticResource PanelShell}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Engineering notes" FontWeight="SemiBold" />
                        <TextBox x:Name="NotesText" Margin="0,6,0,0" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove context" Click="Remove_Click" MinWidth="110" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="82" Margin="0,0,8,0" />
                <Button Content="Apply" Click="Apply_Click" MinWidth="92" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
